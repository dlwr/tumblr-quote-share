      "shortcuts": [
        {
          "id": "9547bc00-a312-4ca7-b73e-ac5ab1783b3f",
          "executionType": "app",
          "name": "Tumblr Quote",
          "description": "共有した選択テキストを Tumblr の quote 投稿にする",
          "iconName": "flat_grey_quote",
          "method": "POST",
          "url": "https://api.tumblr.com/v2/blog/{{tumblr_blog}}/post",
          "requestBodyType": "custom_text",
          "contentType": "application/json",
          "bodyContent": "{{post_body}}",
          "headers": [
            { "key": "Authorization", "value": "Bearer {{tumblr_access_token}}" }
          ],
          "waitForInternet": true,
          "launcherShortcut": true,
          "secondaryLauncherShortcut": true,
          "responseHandling": {
            "uiType": "toast",
            "successOutput": "none",
            "failureOutput": "none"
          },
          "codeOnPrepare": "",
          "codeOnSuccess": "",
          "codeOnFailure": ""
        }
      ]
    }
  ],
